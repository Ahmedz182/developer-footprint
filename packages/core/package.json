{
  "name": "@developer-footprint/core",
  "version": "0.1.0",
  "description": "Developer Footprint Protocol core: parse, validate, canonicalize, sign and verify. No network, no telemetry.",
  "license": "MIT",
  "author": {
    "name": "Muhammad Ahmed Fayyaz",
    "url": "https://ahmedfayyaz.vercel.app/"
  },
  "homepage": "https://github.com/Ahmedz182/developer-footprint#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ahmedz182/developer-footprint.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Ahmedz182/developer-footprint/issues"
  },
  "keywords": [
    "developer-footprint",
    "protocol",
    "provenance",
    "authorship",
    "signature",
    "ed25519",
    "verification",
    "supply-chain"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev": "vitest",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  }
}
