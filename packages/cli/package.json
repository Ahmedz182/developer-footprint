{
  "name": "developer-footprint",
  "version": "0.1.0",
  "description": "Verifiable software authorship and provenance: create an identity, sign a project footprint, verify it offline. CLI, SDK and a drop-in badge for any website.",
  "license": "MIT",
  "author": {
    "name": "Muhammad Ahmed Fayyaz",
    "url": "https://ahmedfayyaz.vercel.app/"
  },
  "homepage": "https://github.com/Ahmedz182/developer-footprint#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ahmedz182/developer-footprint.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Ahmedz182/developer-footprint/issues"
  },
  "keywords": [
    "developer-footprint",
    "provenance",
    "authorship",
    "signature",
    "ed25519",
    "verification",
    "cli",
    "web-component",
    "custom-element",
    "supply-chain"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": [
    "./dist/bin.js",
    "./dist/web/register.js",
    "./dist/browser/*"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    },
    "./register": {
      "types": "./dist/web/register.d.ts",
      "default": "./dist/web/register.js"
    },
    "./browser": "./dist/browser/badge.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "developer-footprint": "./dist/bin.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../tooling/assemble-package.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "vitest"
  },
  "devDependencies": {
    "@developer-footprint/core": "workspace:*",
    "@developer-footprint/web": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
